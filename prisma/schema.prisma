datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output = "../src/generated"
}

model Sermon {
  id        Int      @id @default(autoincrement())
  title     String
  date      DateTime
  speaker   String
  videoUrl  String?
}

model ChurchEvent {
  id          Int      @id @default(autoincrement())
  eventName   String
  date        DateTime
  description String
  signupLink  String?
}
